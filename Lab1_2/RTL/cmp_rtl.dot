digraph "cmp" {
label="cmp";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="A", color="black", fontcolor="black" ];
n2 [ shape=diamond, label="B", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="gt", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="key1", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="key2", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="led1", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="led2", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="led3", color="black", fontcolor="black" ];
n9 [ shape=diamond, label="lt", color="black", fontcolor="black" ];
c11 [ shape=record, label="{{<p1> A|<p2> B}|$7\n$and|{<p10> Y}}" ];
c12 [ shape=record, label="{{<p1> A|<p2> B}|$9\n$and|{<p10> Y}}" ];
c13 [ shape=record, label="{{<p1> A}|$1\n$not|{<p10> Y}}" ];
c14 [ shape=record, label="{{<p1> A}|$2\n$not|{<p10> Y}}" ];
c15 [ shape=record, label="{{<p1> A}|$3\n$not|{<p10> Y}}" ];
c16 [ shape=record, label="{{<p1> A}|$5\n$not|{<p10> Y}}" ];
c17 [ shape=record, label="{{<p1> A|<p2> B}|$10\n$xor|{<p10> Y}}" ];
c13:p10:e -> n1:w [color="black", label=""];
n1:e -> c12:p1:w [color="black", label=""];
n1:e -> c17:p1:w [color="black", label=""];
c14:p10:e -> n2:w [color="black", label=""];
n2:e -> c11:p2:w [color="black", label=""];
n2:e -> c17:p2:w [color="black", label=""];
c12:p10:e -> n3:w [color="black", label=""];
n3:e -> c16:p1:w [color="black", label=""];
n4:e -> c11:p1:w [color="black", label=""];
n4:e -> c13:p1:w [color="black", label=""];
n5:e -> c12:p2:w [color="black", label=""];
n5:e -> c14:p1:w [color="black", label=""];
c15:p10:e -> n6:w [color="black", label=""];
c17:p10:e -> n7:w [color="black", label=""];
c16:p10:e -> n8:w [color="black", label=""];
c11:p10:e -> n9:w [color="black", label=""];
n9:e -> c15:p1:w [color="black", label=""];
}
